# Copy to apps/api/.env for local development. Never commit the real .env.

# OpenAI API key for speech recognition. Without it the API still starts,
# but POST /recitations/evaluate returns 503.
OPENAI_API_KEY=

# Speech model. whisper-1 is the only OpenAI model that returns word
# timestamps, which the waṣl/waqf (stop/join) checks need.
ASR_MODEL=whisper-1

PORT=4000

# Comma-separated browser origins allowed to call the API.
# Add the deployed web URL, and capacitor://localhost,https://localhost for a
# Capacitor mobile build.
CORS_ORIGINS=http://localhost:3000

# Set to "true" or a hop count when running behind a reverse proxy, so rate
# limiting sees real client IPs.
TRUST_PROXY=

# Upload size limit and paid-evaluation rate limit (per client IP).
MAX_AUDIO_MB=10
EVALUATIONS_PER_MINUTE=20
