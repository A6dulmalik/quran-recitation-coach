# Copy to apps/web/.env.local. NEXT_PUBLIC_* values are baked in at build time
# and are visible to anyone: never put secrets here.

# Evaluation API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Reference recitation audio, one MP3 per ayah at {base}/{SSS}{AAA}.mp3
NEXT_PUBLIC_RECITATION_AUDIO_BASE=https://everyayah.com/data/Alafasy_128kbps
NEXT_PUBLIC_RECITER_NAME=Mishary Rashid Alafasy

# Set to 1 only when deployed on Vercel with Web Analytics enabled
NEXT_PUBLIC_VERCEL_ANALYTICS=
