{
  "name": "quran-recitation-coach-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "turbo typecheck lint test build",
    "dev:web": "npm run dev --workspace @apps/web",
    "dev:api": "npm run dev --workspace @apps/api",
    "e2e": "npm run e2e --workspace @apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "tsup": "^8.3.5",
    "turbo": "^2.0.14",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
