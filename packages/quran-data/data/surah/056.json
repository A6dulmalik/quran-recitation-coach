,"text":"وَقَلِيلٌ مِّنَ ٱلْـَٔاخِرِينَ","clean":"وقليل من الآخرين","juz":27,"page":534},{"number":15,"text":"عَلَىٰ سُرُرٍ مَّوْضُونَةٍ","clean":"على سرر موضونة","juz":27,"page":534},{"number":16,"text":"مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَـٰبِلِينَ","clean":"متكئين عليها متقابلين","juz":27,"page":534},{"number":17,"text":"يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ","clean":"يطوف عليهم ولدان مخلدون","juz":27,"page":535},{"number":18,"text":"بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ","clean":"بأكواب وأباريق وكأس من معين","juz":27,"page":535},{"number":19,"text":"لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ","clean":"لا يصدعون عنها ولا ينزفون","juz":27,"page":535},{"number":20,"text":"وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ","clean":"وفاكهة مما يتخيرون","juz":27,"page":535},{"number":21,"text":"وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ","clean":"ولحم طير مما يشتهون","juz":27,"page":535},{"number":22,"text":"وَحُورٌ عِينٌ","clean":"وحور عين","juz":27,"page":535},{"number":23,"text":"كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ","clean":"كأمثال اللؤلؤ المكنون","juz":27,"page":535},{"number":24,"text":"جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ","clean":"جزاء بما كانوا يعملون","juz":27,"page":535},{"number":25,"text":"لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا","clean":"لا يسمعون فيها لغوا ولا تأثيما","juz":27,"page":535},{"number":26,"text":"إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا","clean":"إلا قيلا سلاما سلاما","juz":27,"page":535},{"number":27,"text":"وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ","clean":"وأصحاب اليمين ما أصحاب اليمين","juz":27,"page":535},{"number":28,"text":"فِى سِدْرٍ مَّخْضُودٍ","clean":"في سدر مخضود","juz":27,"page":535},{"number":29,"text":"وَطَلْحٍ مَّنضُودٍ","clean":"وطلح منضود","juz":27,"page":535},{"number":30,"text":"وَظِلٍّ مَّمْدُودٍ","clean":"وظل ممدود","juz":27,"page":535},{"number":31,"text":"وَمَآءٍ مَّسْكُوبٍ","clean":"وماء مسكوب","juz":27,"page":535},{"number":32,"text":"وَفَـٰكِهَةٍ كَثِيرَةٍ","clean":"وفاكهة كثيرة","juz":27,"page":535},{"number":33,"text":"لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ","clean":"لا مقطوعة ولا ممنوعة","juz":27,"page":535},{"number":34,"text":"وَفُرُشٍ مَّرْفُوعَةٍ","clean":"وفرش مرفوعة","juz":27,"page":535},{"number":35,"text":"إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً","clean":"إنا أنشأناهن إنشاء","juz":27,"page":535},{"number":36,"text":"فَجَعَلْنَـٰهُنَّ أَبْكَارًا","clean":"فجعلناهن أبكارا","juz":27,"page":535},{"number":37,"text":"عُرُبًا أَتْرَابًا","clean":"عربا أترابا","juz":27,"page":535},{"number":38,"text":"لِّأَصْحَـٰبِ ٱلْيَمِينِ","clean":"لأصحاب اليمين","juz":27,"page":535},{"number":39,"text":"ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ","clean":"ثلة من الأولين","juz":27,"page":535},{"number":40,"text":"وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ","clean":"وثلة من الآخرين","juz":27,"page":535},{"number":41,"text":"وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ","clean":"وأصحاب الشمال ما أصحاب الشمال","juz":27,"page":535},{"number":42,"text":"فِى سَمُومٍ وَحَمِيمٍ","clean":"في سموم وحميم","juz":27,"page":535},{"number":43,"text":"وَظِلٍّ مِّن يَحْمُومٍ","clean":"وظل من يحموم","juz":27,"page":535},{"number":44,"text":"لَّا بَارِدٍ وَلَا كَرِيمٍ","clean":"لا بارد ولا كريم","juz":27,"page":535},{"number":45,"text":"إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ","clean":"إنهم كانوا قبل ذلك مترفين","juz":27,"page":535},{"number":46,"text":"وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ","clean":"وكانوا يصرون على الحنث العظيم","juz":27,"page":535},{"number":47,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ","clean":"وكانوا يقولون أئذا متنا وكنا ترابا وعظاما أإنا لمبعوثون","juz":27,"page":535},{"number":48,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ","clean":"أوآباؤنا الأولون","juz":27,"page":535},{"number":49,"text":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ","clean":"قل إن الأولين والآخرين","juz":27,"page":535},{"number":50,"text":"لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ","clean":"لمجموعون إلى ميقات يوم معلوم","juz":27,"page":535},{"number":51,"text":"